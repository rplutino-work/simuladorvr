// Race Room - Racing Simulator Booking System
// Database: PostgreSQL (Neon compatible)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// User - Authentication & RBAC
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      UserRole @default(OPERATOR)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([role])
}

enum UserRole {
  ADMIN
  OPERATOR
}

// ─────────────────────────────────────────────────────────────────────────────
// BusinessSettings - Singleton config (one row)
// ─────────────────────────────────────────────────────────────────────────────

model BusinessSettings {
  id                    String   @id @default(cuid())
  openHour              Int      // e.g. 10
  closeHour             Int      // e.g. 20
  slotInterval          Int      // minutes, e.g. 15
  allowCancel           Boolean  @default(true)
  allowReschedule       Boolean  @default(true)
  cancelLimitHours      Int      // min hours before start to allow cancel
  negativeMarginMinutes Int      // buffer before/after slots
  // Email settings
  emailEnabled          Boolean  @default(true)
  emailFrom             String?  // overrides EMAIL_FROM env var when set
  // Cancellation & refund settings
  cancelMode            String   @default("MANUAL") // "MANUAL" | "AUTOMATIC"
  contactPhone          String?  // WhatsApp number for manual refunds (e.g. 5491112345678)
  // Prueba gratis (código 8888): minutos de cooldown por simulador entre pruebas.
  // 0 = sin cooldown (desactivado). El código staff (RRRR) no usa cooldown.
  trialCooldownMin      Int      @default(10)
  // Group discount: progressive % off when booking several puestos together.
  groupDiscountEnabled  Boolean  @default(false)
  groupDiscountTiers     Json?   // { "2":5, "3":10, "4":15, "5":20 } — puestos → % off
  groupDiscountFrom     DateTime? // promo validity start (null = always)
  groupDiscountTo       DateTime? // promo validity end (null = always)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Puesto - Simulator station
// ─────────────────────────────────────────────────────────────────────────────

model Puesto {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  // Pricing (stored in cents for precision)
  price30   Int      @default(0)
  price60   Int      @default(0)
  price90   Int      @default(0)
  price120  Int      @default(0)

  bookings    Booking[]
  heartbeats  DeviceHeartbeat[]

  @@index([active])
  @@index([name])
}

// ─────────────────────────────────────────────────────────────────────────────
// DeviceHeartbeat - Liveness ping from tablet/TV WebViews (one row per device)
// ─────────────────────────────────────────────────────────────────────────────

model DeviceHeartbeat {
  id         String     @id @default(cuid())
  puestoId   String
  deviceType DeviceType
  lastSeenAt DateTime   @default(now())
  userAgent  String?

  puesto     Puesto     @relation(fields: [puestoId], references: [id], onDelete: Cascade)

  @@unique([puestoId, deviceType])
  @@index([puestoId])
}

enum DeviceType {
  TABLET
  TV
}

// ─────────────────────────────────────────────────────────────────────────────
// RateLimit - fixed-window counter (brute-force / abuse protection)
// ─────────────────────────────────────────────────────────────────────────────

model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Booking - Reservation entity
// ─────────────────────────────────────────────────────────────────────────────

model Booking {
  id         String         @id @default(cuid())
  puestoId   String
  duration   Int            // 30, 60, 120 minutes
  price      Int            // Amount in cents
  status     BookingStatus  @default(PENDING)
  code       String?        @unique // 6-digit alphanumeric, generated on payment
  startTime  DateTime?
  endTime    DateTime?
  paymentId     String?        // MercadoPago payment ID (último pago aplicado)
  extPaymentIds String[]       @default([]) // mpPaymentIds de extensiones ya aplicadas (idempotencia por-pago)
  customerEmail String?        // For sending confirmation email
  customerName  String?        // Optional: walk-in customer name
  notes         String?        // Admin internal notes
  cancelToken   String?        @unique // UUID token for self-service cancellation URL
  groupId       String?        // links bookings reserved together as a group
  groupCode     String?        // shared access code for the whole group
  createdAt     DateTime       @default(now())

  puesto     Puesto         @relation(fields: [puestoId], references: [id], onDelete: Restrict)
  payment    Payment?

  @@index([puestoId])
  @@index([status])
  @@index([code])
  @@index([createdAt])
  @@index([startTime])
  @@index([puestoId, startTime])
  @@index([puestoId, status]) // tablet/TV status: "active booking for this puesto?"
  @@index([status, endTime]) // cron auto-finish: ACTIVE with endTime < now
  @@index([status, createdAt]) // cron expire: PENDING older than 30 min
  @@index([groupId]) // fetch/activate all bookings of a group
  @@index([groupCode]) // look up a group by its shared code
}

enum BookingStatus {
  PENDING
  PAID
  ACTIVE
  FINISHED
  EXPIRED
  CANCELLED
}

// ─────────────────────────────────────────────────────────────────────────────
// Payment - MercadoPago transaction record
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id          String   @id @default(cuid())
  bookingId   String   @unique
  mpPaymentId String  // MercadoPago external reference
  amount      Int      // Amount in cents
  status      String   // approved, pending, rejected
  createdAt   DateTime @default(now())

  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([mpPaymentId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// PromoCode - códigos promocionales de TIEMPO GRATIS, configurables desde el admin
// (reemplaza a los códigos hardcodeados 8888/RRRR/9999 en activate/route.ts).
// ─────────────────────────────────────────────────────────────────────────────

model PromoCode {
  id            String    @id @default(cuid())
  code          String    @unique              // se guarda en MAYÚSCULAS
  label         String?                        // nombre/descripción para el admin
  minutes       Int                            // minutos de juego GRATIS que otorga
  maxUses       Int?                           // usos totales máximos (null = ilimitado)
  usedCount     Int       @default(0)          // usos consumidos
  cooldownMin   Int       @default(0)          // no reusar en el MISMO puesto por X min (0 = sin cooldown)
  validFrom     DateTime?                      // vigente desde (null = sin límite)
  validTo       DateTime?                      // vigente hasta (null = sin límite)
  validDays     Int[]     @default([])         // días permitidos 0=dom..6=sáb ([] = todos)
  validHourFrom Int?                           // hora AR desde 0-23 (null = sin límite)
  validHourTo   Int?                           // hora AR hasta 0-23 exclusiva (null = sin límite)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([active])
}
